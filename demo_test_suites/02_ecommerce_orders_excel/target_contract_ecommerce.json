{
  "contract_name": "ecommerce_order_fulfillment_contract",
  "version": "1.0.0",
  "description": "Standard schema for retail shopping orders, payment capture, and delivery fulfillment.",
  "fields": {
    "order_id": {
      "target_type": "string",
      "required": true,
      "nullable": false,
      "pattern": "^ORD-[0-9]{5}$",
      "description": "Standard order identifier",
      "name": "order_id"
    },
    "customer_email": {
      "target_type": "string",
      "required": true,
      "nullable": false,
      "description": "Purchaser email address",
      "name": "customer_email"
    },
    "order_date": {
      "target_type": "datetime",
      "required": true,
      "nullable": false,
      "description": "Timestamp of order placement",
      "name": "order_date"
    },
    "order_status": {
      "target_type": "string",
      "required": true,
      "nullable": false,
      "allowed_values": [
        "Pending",
        "Processing",
        "Shipped",
        "Delivered",
        "Cancelled"
      ],
      "description": "Fulfillment lifecycle state",
      "name": "order_status"
    },
    "item_count": {
      "target_type": "integer",
      "required": true,
      "nullable": false,
      "description": "Total quantity of items in the order",
      "name": "item_count"
    },
    "order_total": {
      "target_type": "float",
      "required": true,
      "nullable": false,
      "description": "Final order amount in USD",
      "name": "order_total"
    },
    "shipping_country": {
      "target_type": "string",
      "required": true,
      "nullable": false,
      "allowed_values": [
        "US",
        "CA",
        "GB",
        "DE",
        "FR",
        "IN",
        "AU"
      ],
      "description": "Two-letter ISO 3166-1 country code",
      "name": "shipping_country"
    },
    "is_priority_shipping": {
      "target_type": "boolean",
      "required": true,
      "nullable": false,
      "description": "Express or priority shipping selected",
      "name": "is_priority_shipping"
    }
  }
}