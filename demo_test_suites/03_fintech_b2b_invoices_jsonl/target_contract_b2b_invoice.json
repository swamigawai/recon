{
  "contract_name": "b2b_vendor_invoice_payable_contract",
  "version": "1.0.0",
  "description": "Standard schema for accounts payable supplier invoices and tax reconciliation.",
  "fields": {
    "invoice_number": {
      "target_type": "string",
      "required": true,
      "nullable": false,
      "pattern": "^INV-[0-9]{5}$",
      "description": "Standard tax invoice identifier",
      "name": "invoice_number"
    },
    "vendor_id": {
      "target_type": "string",
      "required": true,
      "nullable": false,
      "description": "Vendor ERP account number",
      "name": "vendor_id"
    },
    "invoice_date": {
      "target_type": "datetime",
      "required": true,
      "nullable": false,
      "description": "Date invoice was issued",
      "name": "invoice_date"
    },
    "due_date": {
      "target_type": "datetime",
      "required": true,
      "nullable": false,
      "description": "Net payment due date",
      "name": "due_date"
    },
    "currency": {
      "target_type": "string",
      "required": true,
      "nullable": false,
      "allowed_values": [
        "USD",
        "EUR",
        "GBP",
        "INR"
      ],
      "description": "Three-letter ISO currency code",
      "name": "currency"
    },
    "subtotal": {
      "target_type": "float",
      "required": true,
      "nullable": false,
      "description": "Pre-tax amount",
      "name": "subtotal"
    },
    "tax_amount": {
      "target_type": "float",
      "required": true,
      "nullable": false,
      "description": "Total calculated tax",
      "name": "tax_amount"
    },
    "total_amount": {
      "target_type": "float",
      "required": true,
      "nullable": false,
      "description": "Gross invoice total due",
      "name": "total_amount"
    },
    "payment_status": {
      "target_type": "string",
      "required": true,
      "nullable": false,
      "allowed_values": [
        "Unpaid",
        "Paid",
        "Partially_Paid",
        "Overdue",
        "Disputed"
      ],
      "description": "Payment settlement status",
      "name": "payment_status"
    }
  }
}