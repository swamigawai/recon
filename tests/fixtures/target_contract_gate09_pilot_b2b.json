{
  "contract_name": "target_contract_gate09_pilot_b2b",
  "version": "1.0.0",
  "description": "Standardized B2B enterprise procurement and vendor billing contract for Gate 09 pilot",
  "fields": {
    "invoice_id": {
      "name": "invoice_id",
      "target_type": "string",
      "required": true,
      "nullable": false,
      "pattern": "^[A-Z0-9\\-\\/]{3,20}$",
      "description": "Unique vendor invoice tracking number"
    },
    "supplier_gstin": {
      "name": "supplier_gstin",
      "target_type": "string",
      "required": true,
      "nullable": false,
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
      "description": "15-character Goods and Services Tax Identification Number of the vendor"
    },
    "buyer_pan": {
      "name": "buyer_pan",
      "target_type": "string",
      "required": true,
      "nullable": false,
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
      "description": "10-character Permanent Account Number of the corporate client"
    },
    "billing_date": {
      "name": "billing_date",
      "target_type": "datetime",
      "required": true,
      "nullable": false,
      "description": "ISO-8601 timestamp of invoice generation"
    },
    "net_amount": {
      "name": "net_amount",
      "target_type": "float",
      "required": true,
      "nullable": false,
      "description": "Net invoice amount in decimal currency format"
    },
    "tax_amount": {
      "name": "tax_amount",
      "target_type": "float",
      "required": false,
      "nullable": true,
      "description": "Total GST tax amount in decimal currency format"
    },
    "hsn_sac_code": {
      "name": "hsn_sac_code",
      "target_type": "string",
      "required": true,
      "nullable": false,
      "pattern": "^[0-9]{4,8}$",
      "description": "Harmonized System of Nomenclature or Service Accounting Code"
    },
    "destination_pin": {
      "name": "destination_pin",
      "target_type": "string",
      "required": true,
      "nullable": false,
      "pattern": "^[1-9][0-9]{5}$",
      "description": "6-digit destination postal PIN code"
    },
    "bank_ifsc": {
      "name": "bank_ifsc",
      "target_type": "string",
      "required": true,
      "nullable": false,
      "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$",
      "description": "11-character Indian Financial System Code"
    },
    "invoice_status": {
      "name": "invoice_status",
      "target_type": "string",
      "required": true,
      "nullable": false,
      "allowed_values": [
        "PENDING",
        "SETTLED",
        "DISPUTED",
        "VOID"
      ],
      "description": "Invoice payment and settlement status"
    },
    "dispatch_notes": {
      "name": "dispatch_notes",
      "target_type": "string",
      "required": false,
      "nullable": true,
      "description": "Vendor handling, shipping remarks, or exception notes"
    }
  }
}
